# 数据库配置
DATABASE_URL=mysql+pymysql://username:password@host:3306/test_platform

# Redis 配置
REDIS_URL=redis://host:6379/0
CELERY_BROKER_URL=redis://host:6379/0
CELERY_RESULT_BACKEND=redis://host:6379/0

# CORS 配置
CORS_ORIGINS=http://localhost:3000,https://your-domain.tcloudbaseapp.com

# 应用配置
APP_NAME=自动化测试平台
API_V1_PREFIX=/api/v1
BACKEND_PUBLIC_URL=https://your-env.service.tcloudbase.com
FRONTEND_PUBLIC_URL=https://your-domain.tcloudbaseapp.com