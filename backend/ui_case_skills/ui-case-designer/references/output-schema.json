{
  "type": "object",
  "required": [
    "name",
    "folder_path",
    "target_url",
    "priority",
    "expect_text",
    "tags_json",
    "steps_json",
    "assertions_json",
    "design_notes",
    "warnings"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "folder_path": { "type": ["string", "null"], "maxLength": 255 },
    "target_url": { "type": "string" },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "expect_text": { "type": "string", "minLength": 1, "maxLength": 255 },
    "tags_json": { "type": "array", "items": { "type": "string" }, "maxItems": 12 },
    "steps_json": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "name": { "type": "string" },
          "target": { "type": "string" },
          "test_id": { "type": "string" },
          "role": { "type": "string" },
          "accessible_name": { "type": "string" },
          "label": { "type": "string" },
          "placeholder": { "type": "string" },
          "text": { "type": "string" },
          "action": {
            "enum": [
              "goto", "click", "fill", "press", "select_option", "check",
              "uncheck", "hover", "wait", "wait_for_selector", "wait_for_text",
              "assert_text", "assert_visible", "assert_hidden", "assert_url_contains",
              "assert_title_contains", "set_viewport"
            ]
          },
          "selector": { "type": "string" },
          "value": { "description": "Required for goto, fill, press, select_option, wait_for_text, and assert_text." },
          "duration_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
          "state": { "enum": ["visible", "hidden", "attached", "detached"] },
          "wait_until": { "enum": ["domcontentloaded", "load", "networkidle"] },
          "width": { "type": "integer", "minimum": 320, "maximum": 3840 },
          "height": { "type": "integer", "minimum": 320, "maximum": 2160 }
        },
        "allOf": [
          {
            "if": { "properties": { "action": { "enum": ["goto", "fill", "press", "select_option", "wait_for_text", "assert_text"] } } },
            "then": { "required": ["value"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "assertions_json": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "name": { "type": "string" },
          "target": { "type": "string" },
          "test_id": { "type": "string" },
          "role": { "type": "string" },
          "accessible_name": { "type": "string" },
          "label": { "type": "string" },
          "placeholder": { "type": "string" },
          "text": { "type": "string" },
          "type": {
            "enum": [
              "text_present", "text_visible", "text_hidden", "selector_visible",
              "selector_hidden", "url_contains", "title_contains", "visual"
            ]
          },
          "selector": { "type": "string" },
          "value": { "type": "string", "description": "Required for text, URL, title, and visual assertions." }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "enum": ["text_present", "text_visible", "text_hidden", "url_contains", "title_contains", "visual"] } } },
            "then": { "required": ["value"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "design_notes": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
    "warnings": { "type": "array", "items": { "type": "string" }, "maxItems": 10 }
  },
  "additionalProperties": false
}
