COMPOSE_PROJECT_NAME=omnitest

# Images published by .github/workflows/publish-deploy.yml.
IMAGE_PREFIX=ghcr.io/zyc123888/ppptest
IMAGE_TAG=latest

# Public address. Use the final HTTPS origin when a reverse proxy is configured.
PUBLIC_HTTP_PORT=80
PUBLIC_URL=http://replace-with-server-ip-or-domain

MARIADB_DATABASE=omnitest
MARIADB_USER=omnitest
MARIADB_PASSWORD=replace-with-a-long-random-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-random-password

# URL-encode special characters in the database password before placing it here.
DOCKER_DATABASE_URL=mysql+pymysql://omnitest:replace-with-url-encoded-password@mysql:3306/omnitest

INITIAL_ADMIN_PASSWORD=replace-before-first-start
# Generate with:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
APP_ENCRYPTION_KEY=replace-with-fernet-key

SEED_DEMO_DATA_ON_BOOTSTRAP=false

# Tune these only after observing the production machine.
CASE_GEN_MAX_CONCURRENCY=4
CASE_GEN_REQUIREMENT_MAX_TOKENS=8000
CASE_GEN_REQUIREMENT_BATCH_CONCURRENCY=2
CASE_GEN_TESTCASE_REPAIR_MAX_ROUNDS=1
CASE_GEN_TRUSTED_SHARD_CONCURRENCY=2
CASE_GEN_SCOPE_INDEX_CONCURRENCY=2
CASE_GEN_SCOPE_INDEX_TWO_PHASE_TRIGGER_SECTIONS=16
CASE_GEN_SCOPE_INDEX_TWO_PHASE_TRIGGER_TEXT=48000
CASE_GEN_TRUSTED_MODEL_GATE_ENABLED=false
CASE_GEN_TRUSTED_SHARD_MAX_ATTEMPTS=2
