APP_ENV=local
APP_VERSION=1.1.0
DATABASE_URL=sqlite:///./test.db

MARIADB_DATABASE=test_platform
MARIADB_USER=tester
MARIADB_PASSWORD=replace-with-database-password
MARIADB_ROOT_PASSWORD=replace-with-root-password
DOCKER_DATABASE_URL=mysql+pymysql://tester:replace-with-database-password@mysql:3306/test_platform

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
BACKEND_INTERNAL_URL=http://backend:8000
FRONTEND_INTERNAL_URL=http://frontend:3000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_PUBLIC_URL=http://127.0.0.1:3000

INITIAL_ADMIN_PASSWORD=replace-with-strong-admin-password
E2E_ADMIN_USER=admin
E2E_ADMIN_PASSWORD=replace-with-strong-admin-password
# Generate with:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
APP_ENCRYPTION_KEY=replace-with-fernet-key

SEED_DEMO_DATA_ON_BOOTSTRAP=false
AUTO_BOOTSTRAP_ON_STARTUP=true
CASE_GEN_WATCHDOG_ENABLED=true
LOCAL_UID=501
LOCAL_GID=20
