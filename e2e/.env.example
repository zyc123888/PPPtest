# ===== Midscene AI 用例运行配置 =====
# 用法：复制本文件为 e2e/.env 并填入你的 API Key（.env 不要提交到 git）。
#      cp .env.example .env

# 模型服务地址（阿里云百炼 DashScope OpenAI 兼容端点）
MIDSCENE_MODEL_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 你的 API Key（在阿里云百炼控制台开通后填入，切勿提交到仓库）
MIDSCENE_MODEL_API_KEY="替换为你的_dashscope_api_key"

# 视觉多模态模型：qwen3.7-plus（已确认支持图片输入）
MIDSCENE_MODEL_NAME="qwen3.7-plus"

# 模型家族标识，Qwen3.x 系列统一填 qwen3（Midscene 用它做最佳适配）
MIDSCENE_MODEL_FAMILY="qwen3"

# 被测前端地址（默认 http://localhost:3000，按需修改）
E2E_BASE_URL="http://localhost:3000"
